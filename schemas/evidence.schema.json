{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "task",
    "spec",
    "spec_version",
    "status",
    "source_commit",
    "checks",
    "independent_review",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EVIDENCE-[A-Z0-9-]+$"
    },
    "task": {
      "type": "string",
      "pattern": "^F[0-9]{3}$"
    },
    "spec": {
      "type": "string",
      "pattern": "^specifications/[a-z0-9-]+\\.json$"
    },
    "spec_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "proposed",
        "measured",
        "independently-reproduced"
      ]
    },
    "source_commit": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "method",
          "procedure",
          "result",
          "artifact"
        ],
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "procedure": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "not-run",
              "pass",
              "fail"
            ]
          },
          "artifact": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        }
      }
    },
    "independent_review": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer",
            "url"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://github.com/reefyai/rewrite-internet/pull/[0-9]+(?:#.*)?$"
            }
          }
        }
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
