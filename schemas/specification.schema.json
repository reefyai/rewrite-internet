{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "risk",
    "task",
    "requirements",
    "sources",
    "decisions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SPEC-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "superseded"
      ]
    },
    "risk": {
      "enum": [
        "normal",
        "enhanced",
        "high"
      ]
    },
    "task": {
      "type": "string",
      "pattern": "^F[0-9]{3}$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^ ]+$"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "reviewer"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github.com/reefyai/rewrite-internet/pull/[0-9]+(?:#.*)?$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reviewed"
          }
        }
      },
      "then": {
        "required": [
          "review"
        ],
        "properties": {
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "reviewer"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://github.com/reefyai/rewrite-internet/pull/[0-9]+(?:#.*)?$"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
